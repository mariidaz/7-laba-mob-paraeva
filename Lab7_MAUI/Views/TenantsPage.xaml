<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Lab7_MAUI.ViewModels"
             xmlns:models="clr-namespace:Lab7_MAUI.Models"
             x:Class="Lab7_MAUI.Views.TenantsPage"
             x:DataType="vm:TenantsViewModel"
             Title="Мешканці"
             BackgroundColor="#F1F5F9">

    <Grid RowDefinitions="Auto,*">

        <!-- Mobile Top App Bar -->
        <Border Grid.Row="0" StrokeThickness="0,0,0,1" Stroke="#E2E8F0" BackgroundColor="White" Padding="16,14">
            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center" MaximumWidthRequest="540" HorizontalOptions="Fill">
                <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                    <Label Text="👥 Мешканці" FontSize="20" FontAttributes="Bold" TextColor="#0F172A" />
                    <Label Text="Абоненти та підключені послуги" FontSize="12" TextColor="#64748B" />
                </VerticalStackLayout>

                <Button Grid.Column="1"
                        Text="+ Додати"
                        Command="{Binding ShowCreateCommand}"
                        IsVisible="{Binding IsListView}"
                        BackgroundColor="#2563EB"
                        TextColor="White"
                        FontAttributes="Bold"
                        FontSize="13"
                        CornerRadius="12"
                        Padding="14,8"
                        MinimumHeightRequest="38"
                        VerticalOptions="Center" />
            </Grid>
        </Border>

        <!-- Main Scrollable Body -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,14,16,28" Spacing="14" MaximumWidthRequest="540" HorizontalOptions="Fill">

                <!-- 1. LIST VIEW -->
                <VerticalStackLayout Spacing="12" IsVisible="{Binding IsListView}">

                    <!-- Search Box -->
                    <Border StrokeShape="RoundRectangle 14" Stroke="#CBD5E1" StrokeThickness="1" BackgroundColor="White" Padding="12,2">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalOptions="Center">
                            <Label Grid.Column="0" Text="🔍" FontSize="15" VerticalOptions="Center" />
                            <Entry Grid.Column="1"
                                   Text="{Binding SearchText}"
                                   Placeholder="Пошук мешканця за ПІБ..."
                                   PlaceholderColor="#94A3B8"
                                   FontSize="14"
                                   TextColor="#0F172A"
                                   ClearButtonVisibility="WhileEditing" />
                        </Grid>
                    </Border>

                    <!-- Mobile Cards List -->
                    <CollectionView ItemsSource="{Binding Tenants}" SelectionMode="None">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.EmptyView>
                            <Border StrokeShape="RoundRectangle 16" Stroke="#E2E8F0" BackgroundColor="White" Padding="24" Margin="0,8,0,0">
                                <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                                    <Label Text="👥" FontSize="28" HorizontalOptions="Center" />
                                    <Label Text="Мешканців не знайдено" FontSize="15" FontAttributes="Bold" TextColor="#334155" HorizontalOptions="Center" />
                                    <Label Text="Спробуйте змінити пошуковий запит або додайте нового абонента." FontSize="12" TextColor="#64748B" HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Border>
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Tenant">
                                <Border StrokeShape="RoundRectangle 16" Stroke="#E2E8F0" StrokeThickness="1" BackgroundColor="White" Padding="14">
                                    <VerticalStackLayout Spacing="12">

                                        <!-- Card Header: Avatar + Name -->
                                        <Grid ColumnDefinitions="46,*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                                            <Border Grid.Column="0" StrokeShape="RoundRectangle 23" BackgroundColor="#DBEAFE" StrokeThickness="0" WidthRequest="46" HeightRequest="46">
                                                <Label Text="{Binding Initials}" FontSize="16" FontAttributes="Bold" TextColor="#1D4ED8" HorizontalOptions="Center" VerticalOptions="Center" />
                                            </Border>

                                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                                <Label Text="{Binding FullName}" FontSize="15" FontAttributes="Bold" TextColor="#0F172A" />
                                                <Label Text="{Binding TenantId, StringFormat='Особовий код абонента: #{0}'}" FontSize="12" TextColor="#64748B" />
                                            </VerticalStackLayout>
                                        </Grid>

                                        <BoxView HeightRequest="1" Color="#F1F5F9" />

                                        <!-- Card Actions -->
                                        <Grid ColumnDefinitions="1.2*,*,*,*" ColumnSpacing="6">
                                            <Button Grid.Column="0"
                                                    Text="⚡ Послуги"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TenantsViewModel}}, Path=ManageServicesCommand}"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="#ECFDF5"
                                                    TextColor="#059669"
                                                    FontAttributes="Bold"
                                                    FontSize="12"
                                                    CornerRadius="10"
                                                    Padding="6,8"
                                                    MinimumHeightRequest="36" />

                                            <Button Grid.Column="1"
                                                    Text="Деталі"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TenantsViewModel}}, Path=ShowDetailsCommand}"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="#F1F5F9"
                                                    TextColor="#334155"
                                                    FontAttributes="Bold"
                                                    FontSize="12"
                                                    CornerRadius="10"
                                                    Padding="6,8"
                                                    MinimumHeightRequest="36" />

                                            <Button Grid.Column="2"
                                                    Text="Змінити"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TenantsViewModel}}, Path=ShowEditCommand}"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="#EFF6FF"
                                                    TextColor="#2563EB"
                                                    FontAttributes="Bold"
                                                    FontSize="12"
                                                    CornerRadius="10"
                                                    Padding="6,8"
                                                    MinimumHeightRequest="36" />

                                            <Button Grid.Column="3"
                                                    Text="Видалити"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TenantsViewModel}}, Path=ShowDeleteCommand}"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="#FEF2F2"
                                                    TextColor="#DC2626"
                                                    FontAttributes="Bold"
                                                    FontSize="12"
                                                    CornerRadius="10"
                                                    Padding="6,8"
                                                    MinimumHeightRequest="36" />
                                        </Grid>

                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <!-- 2. CREATE VIEW -->
                <Border StrokeShape="RoundRectangle 18" Stroke="#E2E8F0" BackgroundColor="White" Padding="18" IsVisible="{Binding IsCreateView}">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="Новий мешканець" FontSize="20" FontAttributes="Bold" TextColor="#0F172A" />
                        <Label Text="Заповніть анкетні дані власника особового рахунку" FontSize="13" TextColor="#64748B" />
                        <BoxView HeightRequest="1" Color="#E2E8F0" />

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Прізвище *" FontAttributes="Bold" TextColor="#334155" FontSize="13" />
                            <Border Stroke="#CBD5E1" StrokeShape="RoundRectangle 12" BackgroundColor="#F8FAFC" Padding="12,4">
                                <Entry Text="{Binding InputLastName}" Placeholder="Напр.: Шевченко" FontSize="14" TextColor="#0F172A" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Ім'я *" FontAttributes="Bold" TextColor="#334155" FontSize="13" />
                            <Border Stroke="#CBD5E1" StrokeShape="RoundRectangle 12" BackgroundColor="#F8FAFC" Padding="12,4">
                                <Entry Text="{Binding InputFirstName}" Placeholder="Напр.: Тарас" FontSize="14" TextColor="#0F172A" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="По батькові" FontAttributes="Bold" TextColor="#334155" FontSize="13" />
                            <Border Stroke="#CBD5E1" StrokeShape="RoundRectangle 12" BackgroundColor="#F8FAFC" Padding="12,4">
                                <Entry Text="{Binding InputMiddleName}" Placeholder="Напр.: Григорович" FontSize="14" TextColor="#0F172A" />
                            </Border>
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,6,0,0">
                            <Button Grid.Column="0"
                                    Text="Скасувати"
                                    Command="{Binding BackToListCommand}"
                                    BackgroundColor="#F1F5F9"
                                    TextColor="#475569"
                                    FontAttributes="Bold"
                                    CornerRadius="12"
                                    Padding="14,12" />
                            <Button Grid.Column="1"
                                    Text="Зберегти"
                                    Command="{Binding SaveCreateCommand}"
                                    BackgroundColor="#2563EB"
                                    TextColor="White"
                                    FontAttributes="Bold"
                                    CornerRadius="12"
                                    Padding="14,12" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- 3. EDIT VIEW -->
                <Border StrokeShape="RoundRectangle 18" Stroke="#E2E8F0" BackgroundColor="White" Padding="18" IsVisible="{Binding IsEditView}">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="Редагування мешканця" FontSize="20" FontAttributes="Bold" TextColor="#0F172A" />
                        <Label Text="Оновіть анкетні дані абонента" FontSize="13" TextColor="#64748B" />
                        <BoxView HeightRequest="1" Color="#E2E8F0" />

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Прізвище *" FontAttributes="Bold" TextColor="#334155" FontSize="13" />
                            <Border Stroke="#CBD5E1" StrokeShape="RoundRectangle 12" BackgroundColor="#F8FAFC" Padding="12,4">
                                <Entry Text="{Binding InputLastName}" FontSize="14" TextColor="#0F172A" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Ім'я *" FontAttributes="Bold" TextColor="#334155" FontSize="13" />
                            <Border Stroke="#CBD5E1" StrokeShape="RoundRectangle 12" BackgroundColor="#F8FAFC" Padding="12,4">
                                <Entry Text="{Binding InputFirstName}" FontSize="14" TextColor="#0F172A" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="По батькові" FontAttributes="Bold" TextColor="#334155" FontSize="13" />
                            <Border Stroke="#CBD5E1" StrokeShape="RoundRectangle 12" BackgroundColor="#F8FAFC" Padding="12,4">
                                <Entry Text="{Binding InputMiddleName}" FontSize="14" TextColor="#0F172A" />
                            </Border>
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,6,0,0">
                            <Button Grid.Column="0"
                                    Text="Назад"
                                    Command="{Binding BackToListCommand}"
                                    BackgroundColor="#F1F5F9"
                                    TextColor="#475569"
                                    FontAttributes="Bold"
                                    CornerRadius="12"
                                    Padding="14,12" />
                            <Button Grid.Column="1"
                                    Text="Оновити"
                                    Command="{Binding SaveEditCommand}"
                                    BackgroundColor="#2563EB"
                                    TextColor="White"
                                    FontAttributes="Bold"
                                    CornerRadius="12"
                                    Padding="14,12" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- 4. DETAILS VIEW -->
                <Border StrokeShape="RoundRectangle 18" Stroke="#E2E8F0" BackgroundColor="White" Padding="18" IsVisible="{Binding IsDetailsView}">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="Картка мешканця" FontSize="20" FontAttributes="Bold" TextColor="#0F172A" />
                        <BoxView HeightRequest="1" Color="#E2E8F0" />

                        <Border StrokeShape="RoundRectangle 12" BackgroundColor="#F8FAFC" Stroke="#E2E8F0" Padding="14">
                            <VerticalStackLayout Spacing="10">
                                <Grid ColumnDefinitions="110,*">
                                    <Label Grid.Column="0" Text="Прізвище:" FontAttributes="Bold" TextColor="#64748B" FontSize="13" />
                                    <Label Grid.Column="1" Text="{Binding SelectedTenant.LastName}" FontAttributes="Bold" TextColor="#0F172A" FontSize="14" />
                                </Grid>
                                <Grid ColumnDefinitions="110,*">
                                    <Label Grid.Column="0" Text="Ім'я:" FontAttributes="Bold" TextColor="#64748B" FontSize="13" />
                                    <Label Grid.Column="1" Text="{Binding SelectedTenant.FirstName}" FontAttributes="Bold" TextColor="#0F172A" FontSize="14" />
                                </Grid>
                                <Grid ColumnDefinitions="110,*">
                                    <Label Grid.Column="0" Text="По батькові:" FontAttributes="Bold" TextColor="#64748B" FontSize="13" />
                                    <Label Grid.Column="1" Text="{Binding SelectedTenant.MiddleName}" FontAttributes="Bold" TextColor="#0F172A" FontSize="14" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,6,0,0">
                            <Button Grid.Column="0"
                                    Text="← До списку"
                                    Command="{Binding BackToListCommand}"
                                    BackgroundColor="#F1F5F9"
                                    TextColor="#475569"
                                    FontAttributes="Bold"
                                    CornerRadius="12"
                                    Padding="14,12" />
                            <Button Grid.Column="1"
                                    Text="✏️ Редагувати"
                                    Command="{Binding ShowEditCommand}"
                                    CommandParameter="{Binding SelectedTenant}"
                                    BackgroundColor="#EFF6FF"
                                    TextColor="#2563EB"
                                    FontAttributes="Bold"
                                    CornerRadius="12"
                                    Padding="14,12" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- 5. DELETE VIEW -->
                <Border StrokeShape="RoundRectangle 18" Stroke="#FECACA" BackgroundColor="White" Padding="18" IsVisible="{Binding IsDeleteView}">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="Видалення абонента" FontSize="20" FontAttributes="Bold" TextColor="#DC2626" />
                        <Label Text="Ви дійсно бажаєте видалити цього мешканця та пов'язані записи?" FontSize="13" TextColor="#64748B" />
                        <BoxView HeightRequest="1" Color="#FEE2E2" />

                        <Border StrokeShape="RoundRectangle 12" BackgroundColor="#FEF2F2" Stroke="#FECACA" Padding="14">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="{Binding SelectedTenant.FullName}" FontSize="16" FontAttributes="Bold" TextColor="#991B1B" />
                                <Label Text="{Binding SelectedTenant.TenantId, StringFormat='ID мешканця: #{0}'}" FontSize="12" TextColor="#B91C1C" />
                            </VerticalStackLayout>
                        </Border>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,6,0,0">
                            <Button Grid.Column="0"
                                    Text="Скасувати"
                                    Command="{Binding BackToListCommand}"
                                    BackgroundColor="#F1F5F9"
                                    TextColor="#475569"
                                    FontAttributes="Bold"
                                    CornerRadius="12"
                                    Padding="14,12" />
                            <Button Grid.Column="1"
                                    Text="🗑️ Видалити"
                                    Command="{Binding ConfirmDeleteCommand}"
                                    BackgroundColor="#DC2626"
                                    TextColor="White"
                                    FontAttributes="Bold"
                                    CornerRadius="12"
                                    Padding="14,12" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>
