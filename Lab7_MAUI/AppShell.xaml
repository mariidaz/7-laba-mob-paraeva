<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Lab7_MAUI.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Lab7_MAUI.Views"
    Title="Комунальні послуги"
    Shell.FlyoutBehavior="Disabled"
    Shell.NavBarIsVisible="False"
    Shell.TabBarBackgroundColor="#FFFFFF"
    Shell.TabBarForegroundColor="#2563EB"
    Shell.TabBarTitleColor="#2563EB"
    Shell.TabBarUnselectedColor="#64748B">

    <TabBar>
        <Tab Title="Головна" Route="DashboardPage">
            <Tab.Icon>
                <FontImageSource Glyph="🏠" Size="20" Color="#2563EB" />
            </Tab.Icon>
            <ShellContent ContentTemplate="{DataTemplate views:DashboardPage}" Route="DashboardPage" />
        </Tab>
        <Tab Title="Мешканці" Route="TenantsPage">
            <Tab.Icon>
                <FontImageSource Glyph="👥" Size="20" Color="#2563EB" />
            </Tab.Icon>
            <ShellContent ContentTemplate="{DataTemplate views:TenantsPage}" Route="TenantsPage" />
        </Tab>
        <Tab Title="Квартири" Route="ApartmentsPage">
            <Tab.Icon>
                <FontImageSource Glyph="🏢" Size="20" Color="#2563EB" />
            </Tab.Icon>
            <ShellContent ContentTemplate="{DataTemplate views:ApartmentsPage}" Route="ApartmentsPage" />
        </Tab>
        <Tab Title="Послуги" Route="ServicesPage">
            <Tab.Icon>
                <FontImageSource Glyph="⚡" Size="20" Color="#2563EB" />
            </Tab.Icon>
            <ShellContent ContentTemplate="{DataTemplate views:ServicesPage}" Route="ServicesPage" />
        </Tab>
        <Tab Title="Рахунки" Route="BillsPage">
            <Tab.Icon>
                <FontImageSource Glyph="🧾" Size="20" Color="#2563EB" />
            </Tab.Icon>
            <ShellContent ContentTemplate="{DataTemplate views:BillsPage}" Route="BillsPage" />
        </Tab>
    </TabBar>

</Shell>
